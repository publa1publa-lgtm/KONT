# PostgreSQL (local). Swap to Neon/Supabase/etc. later via DATABASE_URL only.
DATABASE_URL=postgresql://cf_app:cfadmin@localhost:5432/content_fabric_db

# Sign session JWT cookies
AUTH_SECRET=dev-insecure-auth-secret-change-me

# AES key for OAuth platform tokens at rest (base64, 32 bytes)
TOKEN_ENC_KEY=

# YouTube + Google Drive share GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET.
# Register both redirect URIs in Google Cloud Console (OAuth Web client).
# Also enable YouTube Data API and Google Drive API for the project.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/youtube/oauth/callback
# GOOGLE_DRIVE_REDIRECT_URI=http://localhost:3000/api/google-drive/oauth/callback

# Media storage: local disk under data/uploads
STORAGE_PROVIDER=local
# MEDIA_LOCAL_DIR=

# Optional SMTP
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
