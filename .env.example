# PostgreSQL (local). Swap to Neon/Supabase/etc. later via DATABASE_URL only.
DATABASE_URL=postgresql://cf_app:cfadmin@localhost:5432/content_fabric_db

# Sign session JWT cookies
AUTH_SECRET=dev-insecure-auth-secret-change-me

# AES key for OAuth platform tokens at rest (base64, 32 bytes)
TOKEN_ENC_KEY=

# Media storage: local disk under data/uploads
STORAGE_PROVIDER=local
# MEDIA_LOCAL_DIR=

# Optional SMTP
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
